<idea-plugin>
  <id>com.testy.tests.viewer</id>
  <name>Testy Tests Viewer</name>
  <vendor email="roman.chudov@gmail.com" url="https://github.com/rom8726/testy-goland-plugin">Chudov Roman</vendor>
  <version>0.2.0</version>
  <idea-version since-build="252.0" until-build="253.*"/>
  <description><![CDATA[
    Visual viewer for Testy YAML scenarios — provides structured tree and color highlighting.
  ]]></description>
  <change-notes><![CDATA[
    0.2.0
    - Performance optimizations.
  ]]></change-notes>

  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.go</depends>
  <depends>org.jetbrains.plugins.yaml</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileTypeFactory implementation="com.testy.plugin.TestyFileTypeFactory"/>
    <fileEditorProvider implementation="com.testy.plugin.TestyViewerEditorProvider"/>
    <annotator language="yaml" implementationClass="com.testy.plugin.annotator.TestyAnnotator"/>
    <completion.contributor language="yaml" implementationClass="com.testy.plugin.completion.TestyCompletionContributor"/>
    <foldingBuilder language="yaml" implementationClass="com.testy.plugin.folding.TestyFoldingBuilder"/>
  </extensions>

  <actions>
  </actions>
</idea-plugin>
