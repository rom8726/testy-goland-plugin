<!--    <toolWindow id="testy" factoryClass="com.testy.plugin.ui.testyToolWindowFactory" anchor="right" icon="AllIcons.Actions.ListFiles"/>-->
    <fileTypeFactory implementation="com.testy.plugin.TestyFileTypeFactory"/>
    <fileEditorProvider implementation="com.testy.plugin.TestyViewerEditorProvider"/>
  </extensions>

  <actions>
  </actions>
</idea-plugin>
